{
  "name": "sachain-backend",
  "version": "1.0.0",
  "description": "Backend services and Lambda functions for Sachain",
  "main": "index.js",
  "scripts": {
    "build": "tsc",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:error-scenarios": "jest --testPathPattern=error-scenarios",
    "test:e2e": "jest --config=src/__tests__/e2e/jest.e2e.config.js",
    "test:e2e:watch": "jest --config=src/__tests__/e2e/jest.e2e.config.js --watch",
    "test:e2e:coverage": "jest --config=src/__tests__/e2e/jest.e2e.config.js --coverage",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "health-check": "ts-node scripts/health-check.ts",
    "deploy": "scripts/deploy-with-validation.sh",
    "deploy:dev": "scripts/deploy-with-validation.sh dev",
    "deploy:staging": "scripts/deploy-with-validation.sh staging",
    "deploy:prod": "scripts/deploy-with-validation.sh prod --auto-rollback",
    "validate-deployment": "ts-node scripts/deployment-validation.ts",
    "rollback": "ts-node scripts/rollback-procedures.ts",
    "rollback:emergency": "ts-node scripts/rollback-procedures.ts emergency",
    "rollback:auto": "ts-node scripts/rollback-procedures.ts auto",
    "system-diagnostics": "ts-node scripts/system-diagnostics.ts",
    "performance-check": "ts-node scripts/performance-check.ts"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.0",
    "@types/busboy": "^1.5.4",
    "@types/jest": "^29.0.0",
    "@types/node": "^20.0.0",
    "@types/uuid": "^9.0.8",
    "aws-sdk-client-mock": "^3.0.0",
    "jest": "^29.0.0",
    "ts-jest": "^29.0.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@aws-sdk/client-cloudwatch": "^3.864.0",
    "@aws-sdk/client-cognito-identity-provider": "^3.873.0",
    "@aws-sdk/client-dynamodb": "^3.864.0",
    "@aws-sdk/client-eventbridge": "^3.864.0",
    "@aws-sdk/client-s3": "^3.0.0",
    "@aws-sdk/client-sesv2": "^3.864.0",
    "@aws-sdk/client-sns": "^3.0.0",
    "@aws-sdk/lib-dynamodb": "^3.864.0",
    "@aws-sdk/s3-request-presigner": "^3.0.0",
    "@hashgraph/sdk": "^2.49.2",
    "aws-lambda": "^1.0.7",
    "aws-xray-sdk-core": "^3.10.3",
    "busboy": "^1.6.0",
    "sharp": "^0.34.3",
    "uuid": "^9.0.1"
  }
}